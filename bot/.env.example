# Discord bot token — Discord Developer Portal → your app → Bot → Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord server ID — right-click server name → Copy Server ID
DISCORD_GUILD_ID=your_guild_id_here

# A secret string you make up — must match what you set in the Supabase webhook header
WEBHOOK_SECRET=make_up_a_secret_string_here

# Supabase service role key — used by PayPal webhook to update profiles
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://fqfanqtybvnurhzkoxwr.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Port — Railway sets this automatically, leave as 3000 for local testing
PORT=3000

# Automated GitHub-to-Discord release digest. Apply sql/release-log.sql before
# enabling the webhook, then configure GitHub to POST Push events to /github.
DISCORD_UPDATE_LOG_CHANNEL_ID=your_release_notes_channel_id
DISCORD_UPDATE_LOG_ROLE_ID=your_update_role_id
GITHUB_WEBHOOK_SECRET=make_a_different_secret_here
GITHUB_DEFAULT_BRANCH=main
UPDATE_LOG_WINDOW_HOURS=4
# Set this deliberately; it is the baseline before the first digest, not a guess.
UPDATE_LOG_INITIAL_VERSION=6.153.0
# Optional for public repositories, required to reconcile private-repo force pushes.
GITHUB_API_TOKEN=

